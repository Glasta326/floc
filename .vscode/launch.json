    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'floc'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=floc",
                ]
            },
            
            "args": [
                "d",
                "test_resources/Output.rsa",
                "--chunksize",
                "15",
                "-o",
                "test_resources/Decrypted"
            ]
        },
        {
            "name": "Debug unit tests in executable 'floc'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=floc"
                ]
            }
        }
    ],
}